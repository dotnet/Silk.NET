{
  "native": {
    "sharedDependencies": [],
    "jobs": {
      "SDL": {
        "path": "sources/SDL/Native",
        "submodules": [
          "eng/submodules/sdl"
        ],
        "builds": {
          "android-arm64": { "runner": "ubuntu-latest" },
          "android-arm": { "runner": "ubuntu-latest" },
          "android-x64": {
            "runner": "ubuntu-latest",
            "additionalOutputs": [
              "android"
            ]
          },
          "android-x86": { "runner": "ubuntu-latest" },
          "ios": { "runner": "macos-latest" },
          "iossimulator": { "runner": "macos-latest" },
          "linux-arm64": { "runner": "ubuntu-latest" },
          "linux-arm": { "runner": "ubuntu-latest" },
          "linux-x64": { "runner": "ubuntu-latest" },
          "osx": { "runner": "macos-latest" },
          "tvos": { "runner": "macos-latest" },
          "tvossimulator": { "runner": "macos-latest" },
          "win-arm64": { "runner": "windows-latest" },
          "win-x64": { "runner": "windows-latest" }
        }
      },
      "OpenAL-Soft": {
        "path": "sources/OpenAL/Soft.Native",
        "submodules": [
          "eng/submodules/openal-soft"
        ],
        "builds": {
          "android-arm64": { "runner": "ubuntu-latest" },
          "android-arm": { "runner": "ubuntu-latest" },
          "android-x64": { "runner": "ubuntu-latest" },
          "android-x86": { "runner": "ubuntu-latest" },
          "ios": { "runner": "macos-latest" },
          "iossimulator": { "runner": "macos-latest" },
          "linux-arm64": { "runner": "ubuntu-latest" },
          "linux-arm": { "runner": "ubuntu-latest" },
          "linux-x64": { "runner": "ubuntu-latest" },
          "osx": { "runner": "macos-latest" },
          "tvos": { "runner": "macos-latest" },
          "tvossimulator": { "runner": "macos-latest" },
          "win-arm64": { "runner": "windows-latest" },
          "win-x64": { "runner": "windows-latest" }
        }
      }
    }
  },
  "bindings": {
    "sharedDependencies": [
      "eng/silktouch/shared/**",
      "sources/SilkTouch/**"
    ],
    "jobs": {
      "OpenAL": {
        "submodules": [
          "eng/submodules/openal-soft"
        ],
        "caches": {
          "windows-latest": [
            "openal-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.OpenAL.cs",
          "eng/silktouch/openal/**"
        ]
      },
      "OpenCL": {
        "submodules": [
          "eng/submodules/opencl-docs",
          "eng/submodules/opencl-headers"
        ],
        "caches": {
          "ubuntu-latest": [
            "opencl-linux-clangsharp.stout"
          ],
          "windows-latest": [
            "opencl-windows-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.OpenCL.cs",
          "eng/silktouch/opencl/**"
        ]
      },
      "OpenGL": {
        "submodules": [
          "eng/submodules/egl-registry",
          "eng/submodules/opengl-registry"
        ],
        "caches": {
          "windows-latest": [
            "opengl-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.OpenGL.cs",
          "eng/silktouch/opengl/**",
          "eng/include/**"
        ]
      },
      "OpenXR": {
        "submodules": [
          "eng/submodules/openxr-sdk",
          "eng/submodules/vulkan-headers"
        ],
        "caches": {
          "ubuntu-latest": [
            "openxr-linux-clangsharp.stout"
          ],
          "macos-latest": [
            "openxr-mac-clangsharp.stout"
          ],
          "windows-latest": [
            "openxr-windows-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.OpenXR.cs",
          "eng/silktouch/openxr/**"
        ]
      },
      "SDL": {
        "submodules": [
          "eng/submodules/sdl"
        ],
        "caches": {
          "windows-latest": [
            "sdl-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.SDL.cs",
          "eng/silktouch/sdl/**"
        ]
      },
      "Vulkan": {
        "submodules": [
          "eng/submodules/vulkan-docs",
          "eng/submodules/vulkan-headers"
        ],
        "caches": {
          "ubuntu-latest": [
            "vulkan-linux-clangsharp.stout"
          ],
          "macos-latest": [
            "vulkan-mac-clangsharp.stout"
          ],
          "windows-latest": [
            "vulkan-windows-clangsharp.stout"
          ]
        },
        "dependencies": [
          "sources/SilkTouch/Jobs/Jobs.Vulkan.cs",
          "eng/silktouch/vulkan/**"
        ]
      }
    }
  }
}
