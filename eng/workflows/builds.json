{
  "native": {
    "SDL": {
      "path": "sources/SDL/Native",
      "submodules": [
        "eng/submodules/sdl"
      ],
      "builds": {
        "android": "ubuntu-latest",
        "ios": "macos-latest",
        "iossimulator": "macos-latest",
        "linux-arm64": "ubuntu-latest",
        "linux-arm": "ubuntu-latest",
        "linux-x64": "ubuntu-latest",
        "osx": "macos-latest",
        "tvos": "macos-latest",
        "tvossimulator": "macos-latest",
        "win-arm64": "windows-latest",
        "win-x64": "windows-latest"
      }
    },
    "OpenAL-Soft": {
      "path": "sources/OpenAL/Soft.Native",
      "submodules": [
        "eng/submodules/openal-soft"
      ],
      "builds": {
        "android-arm64": "ubuntu-latest",
        "android-arm": "ubuntu-latest",
        "android-x64": "ubuntu-latest",
        "android-x86": "ubuntu-latest",
        "ios": "macos-latest",
        "iossimulator": "macos-latest",
        "linux-arm64": "ubuntu-latest",
        "linux-arm": "ubuntu-latest",
        "linux-x64": "ubuntu-latest",
        "osx": "macos-latest",
        "tvos": "macos-latest",
        "tvossimulator": "macos-latest",
        "win-arm64": "windows-latest",
        "win-x64": "windows-latest"
      }
    }
  },
  "bindings": {
    "OpenAL": {
      "submodules": [
        "eng/submodules/openal-soft"
      ],
      "caches": {
        "windows-latest": [
          "openal-clangsharp.stout"
        ]
      }
    },
    "OpenCL": {
      "submodules": [
        "eng/submodules/opencl-docs",
        "eng/submodules/opencl-headers"
      ],
      "caches": {
        "windows-latest": [
          "opencl-clangsharp.stout"
        ]
      }
    },
    "OpenGL": {
      "submodules": [
        "eng/submodules/egl-registry",
        "eng/submodules/opengl-registry"
      ],
      "caches": {
        "windows-latest": [
          "opengl-clangsharp.stout"
        ]
      }
    },
    "OpenXR": {
      "submodules": [
        "eng/submodules/openxr-sdk",
        "eng/submodules/vulkan-headers"
      ],
      "caches": {
        "ubuntu-latest": [
          "openxr-linux-clangsharp.stout"
        ],
        "macos-latest": [
          "openxr-mac-clangsharp.stout"
        ],
        "windows-latest": [
          "openxr-windows-clangsharp.stout"
        ]
      }
    },
    "SDL": {
      "submodules": [
        "eng/submodules/sdl"
      ],
      "caches": {
        "windows-latest": [
          "sdl-clangsharp.stout"
        ]
      }
    },
    "Vulkan": {
      "submodules": [
        "eng/submodules/vulkan-docs",
        "eng/submodules/vulkan-headers"
      ],
      "caches": {
        "windows-latest": [
          "vulkan-clangsharp.stout"
        ]
      }
    }
  }
}
